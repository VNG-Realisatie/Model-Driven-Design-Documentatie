function card(n, label) {
    return '<div class="card"><div class="n">' + n + '</div><div class="l">' + label + '</div></div>';
}

function buildReport(totals, totalInstances, actionLog, rootPath, rootGuid) {
    var generated = new Date().toString();

    var css =
        "body{font-family:Segoe UI,Arial,sans-serif;background:#121417;color:#e8e8e8;margin:0;padding:24px;}" +
        "h1{font-size:1.3rem;}" +
        ".summary{color:#9aa0a6;margin-bottom:16px;display:flex;gap:16px;flex-wrap:wrap;}" +
        ".scope{margin-bottom:16px;padding:10px 14px;border:1px solid #3a5a8a;border-radius:8px;background:#18222f;}" +
        ".card{border:1px solid #2c2f33;border-radius:8px;padding:10px 14px;background:#1b1e22;min-width:140px;}" +
        ".card .n{font-size:1.4rem;font-weight:700;}" +
        ".card .l{font-size:.78rem;color:#9aa0a6;}" +
        ".logbox{border:1px solid #2c2f33;border-radius:8px;padding:10px 14px;font-family:Consolas,monospace;font-size:.8rem;background:#1b1e22;margin-top:20px;}" +
        ".line{padding:2px 0;border-bottom:1px dashed #2c2f33;}" +
        ".line.warn{color:#ffcf70;} .line.err{color:#ff9d95;} .line.skip{color:#9aa0a6;} .line.ok{color:#7fe6a0;}";

    var rows = [];
    for (var i = 0; i < actionLog.length; i++) {
        var line = actionLog[i];
        var cls = "";
        if (line.indexOf("FOUT") !== -1) { cls = "err"; }
        else if (line.indexOf("WAARSCHUWING") !== -1) { cls = "warn"; }
        else if (line.indexOf("SKIP") !== -1) { cls = "skip"; }
        else if (line.indexOf("[UITGEVOERD]") !== -1) { cls = "ok"; }
        rows.push('<div class="line ' + cls + '">' + escapeHtml(line) + "</div>");
    }

    return (
        "<!DOCTYPE html><html lang=\"nl\"><head><meta charset=\"UTF-8\"><title>Eindopschoning</title><style>" + css + "</style></head><body>" +
        "<h1>Eindopschoning: 4-staps herkoppeling + tags terugzetten</h1>" +
        '<div class="scope"><strong>Scope:</strong> ' + escapeHtml(rootPath) + " &nbsp;<code>" + escapeHtml(rootGuid) + "</code>" +
        " &middot; connectoren: " + escapeHtml(CONNECTOR_SCOPE) + " (" + connectorsOutOfScope + " buiten scope overgeslagen)</div>" +
        '<div class="summary">' +
        card(totalInstances, "Elementen/attributen/connectoren gevonden") +
        card(totals.herkoppeld, "Stereotypes herkoppeld") +
        card(totals.enumGekoppeld + " / " + totals.enumGevonden, "Enumeratiewaarden gekoppeld") +
        card(totals.teruggezet, "Tagged values teruggezet") +
        card(totals.afgeleid, "Tijdlijn-tags afgeleid") +
        card(totals.verificatieOk, "Verificatie OK") +
        card(totals.verificatieMislukt, "Verificatie mislukt") +
        card(totals.losseDuplicatenVerwijderd, "Losse duplicaten verwijderd") +
        card(totals.tussenTagsOpgeruimd, "Tussen-tags opgeruimd") +
        card(totals.legeLosseVerwijderd, "Lege, niet aan doelprofiel gekoppelde tags verwijderd") +
        card(totals.gesynchroniseerd, "Tagset aangevuld via Synch") +
        card(totals.overgeslagenMulti, "Overgeslagen (meerdere stereotypes)") +
        card(totals.verplichtLeeg, "Verplichte velden leeg") +
        card(totals.fouten, "Fouten") +
        "</div>" +
        '<div class="summary">Modus: ' + (APPLY_CHANGES ? "ECHT UITGEVOERD" : "DRY-RUN") +
        " &middot; CONFIRMED_VNGR_SIM_REMOVED: " + CONFIRMED_VNGR_SIM_REMOVED +
        " &middot; FQName-controle: " + (FQNAME_SUPPORTED === null ? "n.v.t." : (FQNAME_SUPPORTED ? "ja" : "niet beschikbaar")) +
        " &middot; Gegenereerd op " + escapeHtml(generated) + "</div>" +
        '<div class="logbox">' + rows.join("") + "</div>" +
        "</body></html>"
    );
}



            var rowCls = "";
            if (logLine.indexOf("[UITGEVOERD]") === 0) { rowCls = "s-removed"; }
            else if (logLine.indexOf("[DRY-RUN") === 0) { rowCls = "s-changed"; }
            else if (logLine.indexOf("SKIP") === 0) { rowCls = "s-unknown"; }
            else if (logLine.indexOf("FOUT") === 0) { rowCls = "s-removed"; }
            logRows.push('<div class="log-line ' + rowCls + '">' + escapeHtml(logLine) + "</div>");
        }
        actionLogHtml =
            '<section class="group" id="grp-actielog">' +
            '<h2 class="group-heading">' + (APPLY_CHANGES ? "Uitgevoerde wijzigingen" : "Voorgestelde wijzigingen (dry-run - niets is geschreven)") + '</h2>' +
            '<div class="logbox">' + logRows.join("") + "</div>" +
            "</section>";
    }

    var introText = APPLY_CHANGES
        ? "Dit rapport toont de situatie ZOALS AANGETROFFEN bij aanvang van deze run. Tagged-value-wijzigingen (opschonen/herstellen) zijn hieronder (sectie \"Uitgevoerde wijzigingen\") daadwerkelijk doorgevoerd. Stereotypes zijn NIET gewijzigd (bewust uitgesteld tot de eindopschoning) - zie het statusoverzicht onderaan het logboek."
        : "DRY-RUN: dit rapport heeft het model niet gewijzigd. Het toont welke tagged values behouden blijven, welke zouden vervallen en welke gecontroleerd moeten worden. Stereotypes worden door dit script niet gewijzigd.";

    return (
        "<!DOCTYPE html><html lang=\"nl\"><head><meta charset=\"UTF-8\">" +
        "<title>Migratie-inventarisatie " + escapeHtml(SOURCE_LABEL) + " naar " + escapeHtml(TARGET_LABEL) + "</title>" +
        "<style>" + css + "</style></head><body>" +
        '<header class="page"><h1>Migratie-inventarisatie: ' + escapeHtml(SOURCE_LABEL) + " &rarr; " + escapeHtml(TARGET_LABEL) + "</h1>" +
        '<div class="sub">' + escapeHtml(introText) + "<br>" +
        "Voor enumeratie-tags wordt bovendien gecontroleerd of de huidige waarde nog letterlijk in de toegestane lijst van " + escapeHtml(TARGET_LABEL) + " voorkomt (best-effort komma-gebaseerde lijstvergelijking; bij een enkele tag met een komma binnen een optiewaarde kan dit onbetrouwbaar zijn - controleer die handmatig).<br>" +
        "Daarnaast wordt gewaarschuwd als een verplicht veld van " + escapeHtml(TARGET_LABEL) + " niet is ingevuld. Het profiel-XML-formaat kent geen apart 'verplicht'-attribuut; dit wordt afgeleid uit het woord \"verplicht\" in de omschrijving van de tag, wat beperkt betrouwbaar is - controleer bij twijfel de profieldocumentatie zelf.<br>" +
        "Gegenereerd op " + escapeHtml(generated) + "</div></header>" +
        '<div class="container">' +
        legend + summary +
        actionLogHtml +
        sectionsHtml.join("") +
        "</div>" +
        "<footer>Gegenereerd door Migratie_inventarisatie_VNGR_SIM_naar_VNGRMIM12.js binnen Enterprise Architect.</footer>" +
        "</body></html>"
    );
}



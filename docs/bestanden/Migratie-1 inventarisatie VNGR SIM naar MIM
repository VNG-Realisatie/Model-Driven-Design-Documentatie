        Session.Output("Migratie-inventarisatie: profielen inlezen uit de repository...");
        var sourceProfile = loadProfile(SOURCE_TECHNOLOGY_ID, SOURCE_PROFILE_XML_FALLBACK, SOURCE_LABEL);
        var targetProfile = loadProfile(TARGET_TECHNOLOGY_ID, TARGET_PROFILE_XML_FALLBACK, TARGET_LABEL);

        Session.Output("Model doorzoeken...");
        seenConnectorGuids = {}; // register leegmaken vóór een nieuwe scan
        var instances = [];
        if (ROOT_PACKAGE_GUID !== "") {
            var rootPkg = Repository.GetPackageByGuid(ROOT_PACKAGE_GUID);
            if (rootPkg) {
                walkPackage(rootPkg, safeName(rootPkg), instances);
            } else {
                Session.Output("WAARSCHUWING: ROOT_PACKAGE_GUID '" + ROOT_PACKAGE_GUID + "' levert geen package op.");
            }
        } else {
            var modelCount = Repository.Models.Count;
            for (var i = 0; i < modelCount; i++) {
                try {
                    var rootModel = Repository.Models.GetAt(i);
                    if (rootModel) {
                        walkPackage(rootModel, safeName(rootModel), instances);
                    } else {
                        Session.Output("WAARSCHUWING: Repository.Models item #" + i + " is leeg, overgeslagen.");
                    }
                } catch (eRootModel) {
                    Session.Output("WAARSCHUWING: kon Repository.Models item #" + i + " niet verwerken (overgeslagen): " + eRootModel.description);
                }
            }
        }
        Session.Output("Gevonden: " + instances.length + " elementen/attributen/connectoren met een stereotype.");

        if (APPLY_CHANGES) {
            Session.Output("!!! APPLY_CHANGES staat op TRUE - dit script gaat het model nu daadwerkelijk WIJZIGEN. Zorg dat er een backup is. !!!");
        } else {
            Session.Output("APPLY_CHANGES staat op false - dit is een dry-run, er wordt niets geschreven naar het model.");
        }
        var actionLog = applyMigration(sourceProfile, targetProfile, instances);

        reportTechnologyLinkStatus(targetProfile, actionLog);

        Session.Output("Rapport opbouwen...");
        var reportHtml = buildReport(sourceProfile, targetProfile, instances, actionLog);

        writeTextFileUtf8(OUTPUT_HTML_PATH, reportHtml);
        Session.Output("Klaar. Rapport geschreven naar: " + OUTPUT_HTML_PATH);

        if (OPEN_AFTER_GENERATE) {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run('"' + OUTPUT_HTML_PATH + '"', 1, false);
            } catch (eOpen) {
                Session.Output("Kon het rapport niet automatisch openen: " + eOpen.description);
            }
        }
    } catch (e) {
        Session.Output("FOUT: " + e.description);
    }
}


// =====================================================================
// Profiel inlezen: bij voorkeur rechtstreeks uit de repository
// (Repository.GetTechnologyXML), met een optionele fallback naar een
// los XML-bestand als de technology niet geregistreerd is.
// =====================================================================
function loadProfile(technologyId, fallbackPath, label) {
    var xml = "";

    if (technologyId && technologyId !== "") {
        try {
            xml = Repository.GetTechnologyXML(technologyId);
        } catch (eTech) {
            xml = "";
        }
    }

    if (xml && trimStr(xml) !== "") {
        Session.Output("  " + label + ": ingelezen uit repository (technology-id '" + technologyId + "').");
        return parseProfileXmlString(xml);
    }

    if (fallbackPath && fallbackPath !== "") {
        Session.Output("  " + label + ": niet gevonden als technology in de repository, val terug op bestand: " + fallbackPath);
        return parseProfileXmlFile(fallbackPath);
    }

    throw new Error(
        "Kan profiel '" + label + "' niet vinden. Technology-id '" + technologyId + "' is niet geregistreerd " +
        "in deze repository (Configure > Technology > Manage Technologies) en er is geen fallbackbestand opgegeven. " +
        "Controleer het technology-id, of vul SOURCE_PROFILE_XML_FALLBACK / TARGET_PROFILE_XML_FALLBACK in."
    );
}

function parseProfileXmlFile(path) {
    var doc = new ActiveXObject("Msxml2.DOMDocument.6.0");
    doc.async = false;
    doc.setProperty("SelectionLanguage", "XPath");
    var ok = doc.load(path);
    if (!ok) {
        throw new Error("Kan profiel-XML niet laden: " + path + " (" + doc.parseError.reason + ")");
    }
    return extractProfileFromDom(doc);
}

function parseProfileXmlString(xmlString) {
    var doc = new ActiveXObject("Msxml2.DOMDocument.6.0");
    doc.async = false;
    doc.setProperty("SelectionLanguage", "XPath");
    var ok = doc.loadXML(xmlString);
    if (!ok) {
        throw new Error("Kan technology-XML uit de repository niet parsen (" + doc.parseError.reason + ")");
    }
    return extractProfileFromDom(doc);
}

function extractProfileFromDom(doc) {
    var stereoNodes = doc.selectNodes("//UMLProfiles/UMLProfile/Content/Stereotypes/Stereotype");
    var profile = {}; // naam -> { notes, applies:[...], tags: { tagNaam: {type,description,unit,values,default} } }

    for (var i = 0; i < stereoNodes.length; i++) {
        var sNode = stereoNodes.nextNode ? stereoNodes.item(i) : stereoNodes[i];
        var name = sNode.getAttribute("name");
        var notes = sNode.getAttribute("notes");

        var applies = [];
        var applyNodes = sNode.selectNodes("AppliesTo/Apply");
        for (var a = 0; a < applyNodes.length; a++) {
            applies.push(applyNodes.item(a).getAttribute("type"));
        }

        var tags = {};
        var tagNodes = sNode.selectNodes("TaggedValues/Tag");
        for (var t = 0; t < tagNodes.length; t++) {
            var tNode = tagNodes.item(t);
            var tName = tNode.getAttribute("name");
            var tDescription = tNode.getAttribute("description") || "";
            tags[tName] = {
                "type": tNode.getAttribute("type") || "",
                "description": tDescription,
                "unit": tNode.getAttribute("unit") || "",
                "values": tNode.getAttribute("values") || "",
                "default": tNode.getAttribute("default") || "",
                // Het profiel-XML-formaat kent GEEN apart "verplicht"-attribuut;
                // dit wordt best-effort afgeleid uit het woord "verplicht" in de
                // omschrijving. Dit is beperkt betrouwbaar (afhankelijk van hoe
                // consistent dat woord in de profieldocumentatie gebruikt wordt).
                "mandatory": tDescription.toLowerCase().indexOf("verplicht") !== -1
            };
        }

        profile[name] = { notes: notes || "", applies: applies, tags: tags };
    }
    return profile;
}


// =====================================================================
// Model doorlopen
// =====================================================================
function walkPackage(pkg, currentPath, instances) {
    if (!pkg) { return; }
    var i;
    var elements;
    try {
        elements = pkg.Elements;
    } catch (eElems) {
        Session.Output("WAARSCHUWING: kon elementen van package '" + currentPath + "' niet ophalen: " + eElems.description);
        elements = null;
    }
    if (elements) {
        for (i = 0; i < elements.Count; i++) {
            try {
                var el = elements.GetAt(i);
                if (el) { walkElement(el, currentPath, instances); }
            } catch (eEl) {
                Session.Output("WAARSCHUWING: kon element #" + i + " in package '" + currentPath + "' niet verwerken (overgeslagen): " + eEl.description);
            }
        }
    }

    var subPackages;
    try {
        subPackages = pkg.Packages;
    } catch (ePkgs) {
        Session.Output("WAARSCHUWING: kon subpackages van '" + currentPath + "' niet ophalen: " + ePkgs.description);
        subPackages = null;
    }
    if (subPackages) {
        for (i = 0; i < subPackages.Count; i++) {
            try {
                var sub = subPackages.GetAt(i);
                if (sub) {
                    var subName = "(naam onbekend)";
                    try { subName = sub.Name; } catch (eName) { /* negeren */ }
                    walkPackage(sub, currentPath + " / " + subName, instances);
                }
            } catch (eSub) {
                Session.Output("WAARSCHUWING: kon subpackage #" + i + " in '" + currentPath + "' niet verwerken (overgeslagen): " + eSub.description);
            }
        }
    }
}

function safeName(obj) {
    try {
        return obj.Name;
    } catch (e) {
        return "(naam onbekend)";
    }
}

// Register om te voorkomen dat een connector twee keer wordt verwerkt (hij
// hangt namelijk aan ZOWEL zijn bron- als zijn doel-element se .Connectors
// collectie). Wordt aan het begin van main() geleegd.
var seenConnectorGuids = {};

// Connectoren (associaties, generalisaties e.d.) zitten NIET in
// Package.Elements/Element.Elements - EA houdt ze bij in de aparte
// Element.Connectors-collectie van elk van de twee verbonden elementen.
// Deze functie wordt vanuit walkElement voor elk element aangeroepen.
function walkConnectors(el, pathPrefix, instances) {
    var conns;
    try {
        conns = el.Connectors;
    } catch (eConnGet) {
        Session.Output("WAARSCHUWING: kon connectoren van '" + safeName(el) + "' niet ophalen: " + eConnGet.description);
        return;
    }
    if (!conns) { return; }

    for (var i = 0; i < conns.Count; i++) {
        try {
            var conn = conns.GetAt(i);
            if (!conn) { continue; }

            var connGuid = conn.ConnectorGUID;
            if (connGuid && hasOwn(seenConnectorGuids, connGuid)) { continue; } // al verwerkt via het andere uiteinde
            if (connGuid) { seenConnectorGuids[connGuid] = true; }

            var connStereos = splitStereotypes(getStereotypeExSafe(conn));
            if (connStereos.length === 0) { continue; }

            var srcName = "?", tgtName = "?";
            try {
                var srcEl = Repository.GetElementByID(conn.ClientID);
                if (srcEl) { srcName = safeName(srcEl); }
            } catch (eSrc) { /* negeren */ }
            try {
                var tgtEl = Repository.GetElementByID(conn.SupplierID);
                if (tgtEl) { tgtName = safeName(tgtEl); }
            } catch (eTgt) { /* negeren */ }

            var connType = "";
            try { connType = conn.Type; } catch (eType) { connType = ""; }
            var connOwnName = "";
            try { connOwnName = conn.Name; } catch (eName2) { connOwnName = ""; }
            var displayName = (connOwnName && connOwnName !== "") ? connOwnName : (connType + ": " + srcName + " -> " + tgtName);

            for (var k = 0; k < connStereos.length; k++) {
                if (connStereos[k] === "") { continue; }
                instances.push({
                    kind: "Connector",
                    name: displayName,
                    stereotype: connStereos[k],
                    guid: connGuid,
                    ownerGuid: (srcEl ? srcEl.ElementGUID : ""), // element om de connector via .Connectors terug te vinden
                    ownerName: "",
                    path: pathPrefix + " (connector " + connType + ": " + srcName + " -> " + tgtName + ")",
                    taggedValues: collectTags(conn.TaggedValues),
                    obj: conn
                });
            }
        } catch (eConn) {
            Session.Output("WAARSCHUWING: kon connector #" + i + " van '" + safeName(el) + "' niet verwerken (overgeslagen): " + eConn.description);
        }
    }
}

function walkElement(el, pathPrefix, instances) {
    if (!el) { return; }
    var i;
    var elName = safeName(el);

    var stereos = splitStereotypes(getStereotypeExSafe(el));
    for (i = 0; i < stereos.length; i++) {
        if (stereos[i] === "") { continue; }
        try {
            instances.push({
                kind: "Element",
                name: elName,
                stereotype: stereos[i],
                guid: el.ElementGUID,
                ownerGuid: "",
                ownerName: "",
                path: pathPrefix,
                taggedValues: collectTags(el.TaggedValues),
                obj: el
            });
        } catch (eInst) {
            Session.Output("WAARSCHUWING: kon element '" + elName + "' (stereotype '" + stereos[i] + "') niet verwerken (overgeslagen): " + eInst.description);
        }
    }

    // Connectoren die aan dit element hangen (associaties, generalisaties e.d.)
    walkConnectors(el, pathPrefix + " / " + elName, instances);

    // Attributen (bv. Attribuutsoort, Data element, Referentie element, Enumeratiewaarde)
    var attrs;
    try {
        attrs = el.Attributes;
    } catch (eAttrsGet) {
        Session.Output("WAARSCHUWING: kon attributen van '" + elName + "' niet ophalen: " + eAttrsGet.description);
        attrs = null;
    }
    if (attrs) {
        for (i = 0; i < attrs.Count; i++) {
            try {
                var attr = attrs.GetAt(i);
                if (!attr) { continue; }
                var attrName = safeName(attr);
                var attrStereos = splitStereotypes(getStereotypeExSafe(attr));
                for (var k = 0; k < attrStereos.length; k++) {
                    if (attrStereos[k] === "") { continue; }
                    instances.push({
                        kind: "Attribute",
                        name: attrName,
                        stereotype: attrStereos[k],
                        guid: attr.AttributeGUID,
                        ownerGuid: el.ElementGUID,
                        ownerName: elName,
                        path: pathPrefix + " / " + elName,
                        taggedValues: collectTags(attr.TaggedValues),
                        obj: attr
                    });
                }
            } catch (eAttr) {
                Session.Output("WAARSCHUWING: kon attribuut #" + i + " van '" + elName + "' niet verwerken (overgeslagen): " + eAttr.description);
            }
        }
    }

    // Geneste elementen (embedded classifiers e.d.)
    var nested;
    try {
        nested = el.Elements;
    } catch (eNestedGet) {
        Session.Output("WAARSCHUWING: kon geneste elementen van '" + elName + "' niet ophalen: " + eNestedGet.description);
        nested = null;
    }
    if (nested) {
        for (i = 0; i < nested.Count; i++) {
            try {
                var nestedEl = nested.GetAt(i);
                if (nestedEl) { walkElement(nestedEl, pathPrefix + " / " + elName, instances); }
            } catch (eNested) {
                Session.Output("WAARSCHUWING: kon genest element #" + i + " van '" + elName + "' niet verwerken (overgeslagen): " + eNested.description);
            }
        }
    }
}

function getStereotypeExSafe(obj) {
    var s = "";
    try { s = obj.StereotypeEx; } catch (e1) { s = ""; }
    if (!s) {
        try { s = obj.Stereotype; } catch (e2) { s = ""; }
    }
    return s || "";
}

function splitStereotypes(raw) {
    if (!raw) { return []; }
    var parts = raw.split(";");
    var out = [];
    for (var i = 0; i < parts.length; i++) {
        var v = trimStr(parts[i]);
        if (v !== "") { out.push(v); }
    }
    return out;
}

function collectTags(tvCollection) {
    var result = {};
    for (var i = 0; i < tvCollection.Count; i++) {
        var tv = tvCollection.GetAt(i);
        var name = tv.Name;
        var val = getTagValueSafe(tv);

        if (!hasOwn(result, name)) {
            result[name] = val;
        } else {
            // Tagnaam komt dubbel voor op dit element/attribuut/connector -
            // niet zomaar de laatste laten winnen. Een ingevulde waarde
            // nooit overschrijven met een lege duplicaat; is de bestaande
            // leeg en heeft deze duplicaat wel een waarde, dan die
            // alsnog gebruiken.
            var existingVal = result[name];
            var existingHasValue = existingVal !== undefined && existingVal !== null && trimStr(String(existingVal)) !== "";
            var newHasValue = val !== undefined && val !== null && trimStr(String(val)) !== "";

            if (!existingHasValue && newHasValue) {
                result[name] = val;
            } else if (existingHasValue && newHasValue && trimStr(String(existingVal)) !== trimStr(String(val))) {
                Session.Output("WAARSCHUWING: tag '" + name + "' komt dubbel voor met TWEE VERSCHILLENDE waarden (\"" + existingVal + "\" en \"" + val + "\") - \"" + existingVal + "\" wordt gebruikt, controleer dit element handmatig.");
            }
            // (leeg + leeg, of gelijke waarde aan beide kanten: niets te doen)
        }
    }
    return result;
}

function getTagValueSafe(tv) {
    var v = tv.Value;
    // Alleen bij de letterlijke "<memo>"-placeholder (het bekende EA-patroon
    // voor memo-tags, maar gebleken ook gebruikt voor ELKE tag zonder
    // inline value= attribuut, bv. een tag die alleen uit de profiel-
    // omschrijving bestaat) terugvallen op .Notes.
    if (v === "<memo>") {
        try {
            if (tv.Notes) { v = tv.Notes; }
        } catch (e) { /* negeren */ }
    }
    // Bescherming tegen profiel-metadata die per ongeluk als "waarde"
    // wordt gelezen (via .Notes, zoals hierboven, maar mogelijk ook
    // rechtstreeks via .Value bij een kapot/leeg tag-element): EA's eigen
    // export-formaat voor tag-definitiemetadata begint altijd met
    // "Values: ", "Default: " of "Description: " (zie het <UML:Comment
    // name="..."> patroon in een geëxporteerde XMI). Zulke tekst is NOOIT
    // een echte, door een gebruiker ingevulde waarde - behandel als leeg.
    if (v && (v.indexOf("Description: ") === 0 || v.indexOf("Values: ") === 0 || v.indexOf("Default: ") === 0)) {
        v = "";
    }
    return v;
}


// =====================================================================
// Diff-logica (profielniveau, per stereotype)
// =====================================================================
function diffStereotypeTags(stereoName, sourceProfile, targetProfile) {
    var srcTags = (sourceProfile[stereoName] ? sourceProfile[stereoName].tags : {});
    var tgtTags = (targetProfile[stereoName] ? targetProfile[stereoName].tags : {});
    var names = unionSortedKeys(srcTags, tgtTags);

    var rows = [];
    for (var i = 0; i < names.length; i++) {
        var tName = names[i];
        var inSrc = hasOwn(srcTags, tName);
        var inTgt = hasOwn(tgtTags, tName);
        var status, changedFields = [];

        if (inSrc && !inTgt) {
            status = "removed";
        } else if (inTgt && !inSrc) {
            status = "added";
        } else {
            var a = srcTags[tName], b = tgtTags[tName];
            for (var f = 0; f < TAG_FIELDS.length; f++) {
                var fld = TAG_FIELDS[f];
                if (trimStr(a[fld] || "") !== trimStr(b[fld] || "")) { changedFields.push(fld); }
            }
            status = (changedFields.length > 0) ? "changed" : "unchanged";
        }

        rows.push({
            name: tName, status: status, changedFields: changedFields,
            src: srcTags[tName], tgt: tgtTags[tName]
        });
    }
    return rows;
}

function stereotypeMigrationStatus(stereoName, sourceProfile, targetProfile) {
    var inSrc = hasOwn(sourceProfile, stereoName);
    var inTgt = hasOwn(targetProfile, stereoName);
    if (inSrc && inTgt) { return "shared"; }
    if (inSrc && !inTgt) { return "no-equivalent"; }
    if (!inSrc && inTgt) { return "target-only"; }
    return "unknown";
}

// Per concreet model-exemplaar: welke acties horen bij de daadwerkelijk
// ingevulde tagged values?
function buildInstanceActions(instance, tagDiffRows, targetTags) {
    var diffByName = {};
    for (var i = 0; i < tagDiffRows.length; i++) { diffByName[tagDiffRows[i].name] = tagDiffRows[i]; }

    // Index van doelprofiel-tagnamen op hun spatie-genormaliseerde vorm
    // (dubbele spaties -> 1, vooraan/achteraan spaties weg), zodat een
    // tagnaam die alleen in spatiegebruik afwijkt van de officiële
    // profieldefinitie toch herkend wordt in plaats van als "onbekend"
    // te worden afgekeurd.
    var normalizedTargetNames = {};
    for (var ni = 0; ni < tagDiffRows.length; ni++) {
        if (tagDiffRows[ni].tgt) {
            normalizedTargetNames[normalizeWhitespace(tagDiffRows[ni].name)] = tagDiffRows[ni].name;
        }
    }

    var remapForStereotype = TAG_REMAP[instance.stereotype] || {};
    var excludedTagNames = TAG_EXCLUDE_FROM_REMOVAL[instance.stereotype] || [];
    var successfulRemaps = []; // { oldTagName, newTagName, value } - voor de "ontvangt waarde"-rij hieronder
    var customActionsForStereo = CUSTOM_TAG_ACTIONS[instance.stereotype] || {};

    var actions = [];
    for (var tagName in instance.taggedValues) {
        if (!hasOwn(instance.taggedValues, tagName)) { continue; }
        var val = instance.taggedValues[tagName];
        if (val === undefined || val === null || trimStr(String(val)) === "") { continue; } // alleen ingevulde waarden

        // PRIORITEIT: een geconfigureerde aparte actie (CUSTOM_TAG_ACTIONS)
        // gaat altijd voor de normale behouden/vervalt/hernoem-logica.
        if (hasOwn(customActionsForStereo, tagName)) {
            actions.push({
                tagName: tagName, value: val, status: "custom-action",
                note: "Gemarkeerd voor een aparte actie (CUSTOM_TAG_ACTIONS) - wordt standaard NIET automatisch uitgevoerd, alleen getoond. Zet EXECUTE_CUSTOM_TAG_ACTIONS op true om de geconfigureerde functie ook echt te laten draaien.",
                customActionFn: customActionsForStereo[tagName]
            });
            continue;
        }

        var diffRow = diffByName[tagName];
        var status, note;
        var existsInTarget = diffRow && diffRow.tgt; // deze exacte naam is een geldige tag in het doelprofiel

        if (!existsInTarget) {
            // Deze tagnaam bestaat niet (onder deze naam) in het doelprofiel -
            // hetzij omdat hij alleen in het bronprofiel stond ("vervalt"),
            // hetzij omdat hij in GEEN van beide profielen formeel is
            // gedefinieerd (bv. een los/handmatig aangemaakte tag die wel op
            // het model staat). Eerst TAG_EXCLUDE_FROM_REMOVAL checken (die
            // wint altijd - een uitgezonderde tag wordt ook niet hernoemd),
            // dan pas TAG_REMAP.
            if (arrayContains(excludedTagNames, tagName)) {
                actions.push({
                    tagName: tagName, value: val, status: "excluded",
                    note: "Uitgezonderd van verwijdering (TAG_EXCLUDE_FROM_REMOVAL) - blijft ongewijzigd staan, ook al bestaat deze tag niet in " + TARGET_LABEL + "."
                });
                continue;
            }

            // Spatie-verschil? (dubbele spatie, of vooraan/achteraan spatie)
            // Dan automatisch herkennen als dezelfde tag en "hernoemen" naar
            // de correcte, schone naam uit de profieldefinitie - dezelfde
            // afhandeling als een TAG_REMAP, maar dan automatisch gedetecteerd.
            var normalizedTagName = normalizeWhitespace(tagName);
            if (normalizedTagName !== tagName && hasOwn(normalizedTargetNames, normalizedTagName)) {
                var cleanTargetName = normalizedTargetNames[normalizedTagName];
                var cleanCurrentVal = instance.taggedValues[cleanTargetName];
                var cleanHasValue = cleanCurrentVal !== undefined && cleanCurrentVal !== null && trimStr(String(cleanCurrentVal)) !== "";
                if (cleanHasValue) {
                    actions.push({
                        tagName: tagName, value: val, status: "remap-conflict",
                        note: "Tagnaam wijkt alleen af door spatiegebruik van de juiste naam '" + cleanTargetName + "', maar die tag heeft op dit element al een eigen waarde (\"" + cleanCurrentVal + "\"). Combineer handmatig."
                    });
                } else {
                    successfulRemaps.push({ oldTagName: tagName, newTagName: cleanTargetName, value: val });
                    actions.push({
                        tagName: tagName, value: val, status: "renamed",
                        note: "Automatisch herkend als spatie-variant van '" + cleanTargetName + "' - hernoemd naar de correcte schrijfwijze.",
                        remapTarget: cleanTargetName
                    });
                }
                continue;
            }

            var remapTargetTagName = hasOwn(remapForStereotype, tagName) ? remapForStereotype[tagName] : null;

            if (remapTargetTagName) {
                var targetDefExists = hasOwn(diffByName, remapTargetTagName) && diffByName[remapTargetTagName].tgt;
                if (!targetDefExists) {
                    status = diffRow ? "removed" : "unknown";
                    note = "FOUT in TAG_REMAP: doeltag '" + remapTargetTagName + "' bestaat niet in " + TARGET_LABEL + " voor dit stereotype - mapping genegeerd. De waarde gaat verloren tenzij handmatig elders vastgelegd.";
                } else {
                    var targetCurrentVal = instance.taggedValues[remapTargetTagName];
                    var targetHasValue = targetCurrentVal !== undefined && targetCurrentVal !== null && trimStr(String(targetCurrentVal)) !== "";
                    if (targetHasValue) {
                        status = "remap-conflict";
                        note = "Kan niet automatisch hernoemen naar '" + remapTargetTagName + "' - die tag heeft op dit element al een eigen waarde (\"" + targetCurrentVal + "\"). Combineer handmatig.";
                    } else {
                        status = "renamed";
                        note = "Hernoemd/verplaatst naar tag '" + remapTargetTagName + "' (via TAG_REMAP).";
                        successfulRemaps.push({ oldTagName: tagName, newTagName: remapTargetTagName, value: val });
                        actions.push({ tagName: tagName, value: val, status: status, note: note, remapTarget: remapTargetTagName });
                        continue;
                    }
                }
            } else if (!diffRow) {
                status = "unknown";
                note = "Vervalt: komt in GEEN van beide profielen voor als tagdefinitie voor dit stereotype (mogelijk handmatig toegevoegd, of een naam die niet (meer) overeenkomt met de profieldefinitie - controleer op onzichtbare verschillen: " + describeTagNameForDebug(tagName) + "). De waarde gaat verloren tenzij handmatig elders vastgelegd.";
            } else {
                status = "removed";
                note = "Vervalt: deze tagged value bestaat niet in " + TARGET_LABEL + ". De waarde gaat verloren tenzij handmatig elders vastgelegd.";
            }
        } else if (diffRow.status === "changed") {
            if (diffRow.changedFields.length === 1 && diffRow.changedFields[0] === "description") {
                // Alleen de omschrijving/toelichting van de tag is anders - dat is
                // puur tekstueel en heeft geen invloed op de waarde zelf.
                status = "kept";
                note = "Blijft behouden - waarde wordt ongewijzigd overgenomen. (Alleen de toelichting/omschrijving van deze tag is in " + TARGET_LABEL + " aangepast; dat heeft geen invloed op de waarde zelf.)";
            } else {
                status = "changed";
                note = "Blijft behouden, waarde wordt overgenomen. Let op: de tagdefinitie wijkt functioneel af tussen de profielen (" + diffRow.changedFields.join(", ") + ") - controleer of de waarde nog geldig/toegestaan is.";
            }
        } else {
            status = "kept";
            note = "Blijft behouden - waarde wordt ongewijzigd overgenomen.";
        }

        // Extra controle specifiek voor enumeratie-tags: staat de HUIDIGE
        // waarde nog letterlijk in de toegestane lijst van het doelprofiel?
        // Alleen relevant als de tag uberhaupt overleeft (niet 'removed'/
        // 'unknown'), en alleen als het doelprofiel de tag als enumeratie
        // typeert. Best-effort: zie de kanttekening bij parseEnumValues().
        if (status !== "removed" && status !== "unknown" && diffRow && diffRow.tgt && diffRow.tgt.type === "enumeration") {
            var allowedValues = parseEnumValues(diffRow.tgt.values);
            if (allowedValues.length > 0 && !arrayContains(allowedValues, trimStr(String(val)))) {
                status = "invalid-value";
                note = "Waarde \"" + val + "\" komt niet (meer) voor in de toegestane enumeratiewaarden van " + TARGET_LABEL +
                    " (" + allowedValues.join(", ") + "). Let op: deze vergelijking is hoofdlettergevoelig. Deze waarde moet handmatig worden aangepast/vertaald naar een geldige keuze.";
            }
        }

        actions.push({ tagName: tagName, value: val, status: status, note: note });
    }

    // Extra pas: tags die via TAG_REMAP een waarde ONTVANGEN vanaf een
    // hernoemde, oude tagnaam - apart tonen zodat beide kanten van de
    // hernoeming zichtbaar zijn in het rapport.
    var effectiveValues = {}; // tagNaam -> waarde die dit veld effectief zal krijgen (voor de verplicht-check hieronder)
    for (var r = 0; r < successfulRemaps.length; r++) {
        var remap = successfulRemaps[r];
        actions.push({
            tagName: remap.newTagName, value: remap.value, status: "renamed",
            note: "Ontvangt waarde \"" + remap.value + "\" van hernoemde tag '" + remap.oldTagName + "' (via TAG_REMAP).",
            remapSource: remap.oldTagName
        });
        effectiveValues[remap.newTagName] = remap.value;
    }

    // Extra pas: verplichte tagged values uit het DOELPROFIEL die op dit
    // element/attribuut niet zijn ingevuld. Dit staat los van de vorige
    // loop (die alleen al-ingevulde tags behandelt) - een verplicht veld
    // dat leeg is, komt daar per definitie niet in voor. Een tag die via
    // TAG_REMAP alsnog een waarde krijgt, telt niet als leeg.
    for (var m = 0; m < tagDiffRows.length; m++) {
        var mrow = tagDiffRows[m];
        if (!mrow.tgt || !mrow.tgt.mandatory) { continue; }
        var curVal = instance.taggedValues[mrow.name];
        var hasCurVal = curVal !== undefined && curVal !== null && trimStr(String(curVal)) !== "";
        var hasEffectiveVal = hasOwn(effectiveValues, mrow.name);
        if (!hasCurVal && !hasEffectiveVal) {
            actions.push({
                tagName: mrow.name,
                value: "",
                status: "mandatory-missing",
                note: "Verplicht veld volgens " + TARGET_LABEL + " is niet ingevuld op dit element/attribuut. (Verplichting is afgeleid uit het woord \"verplicht\" in de omschrijving - controleer dit bij twijfel.)"
            });
        }
    }

    // Extra pas: tags die in het DOELPROFIEL voor dit stereotype bestaan,
    // maar nog helemaal niet op dit element/attribuut aanwezig zijn (dus
    // niet eens als lege tag) - worden toegevoegd met een lege waarde.
    // Een tag die via TAG_REMAP al een waarde krijgt, wordt hier niet
    // nogmaals toegevoegd (staat al als "renamed"-ontvanger hierboven).
    // Volledig uit te schakelen via ADD_MISSING_TAGS = false.
    if (ADD_MISSING_TAGS) {
        for (var defTagName in targetTags) {
            if (!hasOwn(targetTags, defTagName)) { continue; }
            if (hasOwn(instance.taggedValues, defTagName)) { continue; } // al aanwezig (leeg of gevuld)
            if (hasOwn(effectiveValues, defTagName)) { continue; } // komt al binnen via TAG_REMAP
            actions.push({
                tagName: defTagName, value: "", status: "tag-added",
                note: "Ontbreekt op dit element en wordt toegevoegd (leeg) omdat " + TARGET_LABEL + " deze tag voor dit stereotype definieert."
            });
        }
    }

    // op naam sorteren voor een stabiele weergave
    actions.sort(function (x, y) { return x.tagName < y.tagName ? -1 : (x.tagName > y.tagName ? 1 : 0); });
    return actions;
}

// Voor een stereotype dat GEEN equivalent heeft in het doelprofiel: dan
// vervalt elke ingevulde tagged value op dat element/attribuut, ongeacht
// de tagnaam - er is immers geen stereotype meer om de tag aan te hangen.
function buildAllRemovedActions(instance) {
    var actions = [];
    for (var tagName in instance.taggedValues) {
        if (!hasOwn(instance.taggedValues, tagName)) { continue; }
        var val = instance.taggedValues[tagName];
        if (val === undefined || val === null || trimStr(String(val)) === "") { continue; } // alleen ingevulde waarden

        actions.push({
            tagName: tagName,
            value: val,
            status: "removed",
            note: "Vervalt: het stereotype \"" + instance.stereotype + "\" bestaat niet in " + TARGET_LABEL + ", dus ook deze tagged value kan niet worden overgenomen."
        });
    }
    actions.sort(function (x, y) { return x.tagName < y.tagName ? -1 : (x.tagName > y.tagName ? 1 : 0); });
    return actions;
}


// =====================================================================
// Apply-fase: de wijzigingen daadwerkelijk (of, in dry-run, hypothetisch)
// doorvoeren in het model. Retourneert een logboek (array van strings)
// dat ook in het HTML-rapport wordt opgenomen.
// =====================================================================

function deleteTagFromCollection(tvCollection, tagName) {
    for (var i = 0; i < tvCollection.Count; i++) {
        if (tvCollection.GetAt(i).Name === tagName) {
            tvCollection.Delete(i);
            tvCollection.Refresh();
            return true;
        }
    }
    return false;
}

function setTagValueInCollection(tvCollection, tagName, newValue) {
    for (var i = 0; i < tvCollection.Count; i++) {
        var tv = tvCollection.GetAt(i);
        if (tv.Name === tagName) {
            tv.Value = newValue;
            tv.Update();
            return true;
        }
    }
    return false;
}

function logAction(actionLog, line) {
    actionLog.push(line);
    Session.Output(line);
}

// t_xref-gebaseerde verificatie van de daadwerkelijke technology-koppeling
// (bevestigd patroon uit een eerdere XMI-inspectie van dit model):
//   t_xref.Name = 'Stereotypes', t_xref.Client = <element/attribuut/
//   connector GUID>, t_xref.Type = 'element property' | 'attribute
//   property' | 'connector property', t_xref.Description bevat
//   "...FQName=<Technology>::<Stereotype>;...".
function getStereotypeFQName(guid, xrefType) {
    var sql = "SELECT Description FROM t_xref WHERE Name='Stereotypes' AND Client='" + guid + "' AND Type='" + xrefType + "'";
    var resultXml = "";
    try {
        resultXml = Repository.SQLQuery(sql);
    } catch (eSql) {
        return null;
    }
    if (!resultXml) { return null; }

    var descStart = resultXml.indexOf("<Description>");
    if (descStart === -1) { return null; }
    descStart += "<Description>".length;
    var descEnd = resultXml.indexOf("</Description>", descStart);
    if (descEnd === -1) { return null; }
    var description = resultXml.substring(descStart, descEnd);

    var fqMarker = "FQName=";
    var fqStart = description.indexOf(fqMarker);
    if (fqStart === -1) { return null; }
    fqStart += fqMarker.length;
    var fqEnd = description.indexOf(";", fqStart);
    if (fqEnd === -1) { fqEnd = description.length; }
    return description.substring(fqStart, fqEnd);
}

function verifyRetarget(inst, expectedQualifiedName, actionLog) {
    var xrefType = (inst.kind === "Element") ? "element property"
                 : (inst.kind === "Attribute") ? "attribute property"
                 : "connector property";
    var fqName = getStereotypeFQName(inst.guid, xrefType);
    if (fqName === null) {
        logAction(actionLog, "  Verificatie via t_xref niet mogelijk (geen resultaat) - geen bevestiging, maar ook geen aanwijzing voor een fout.");
    } else if (fqName === expectedQualifiedName) {
        logAction(actionLog, "  Geverifieerd via t_xref: FQName is nu correct '" + fqName + "'.");
    } else {
        logAction(actionLog, "  WAARSCHUWING: t_xref toont FQName '" + fqName + "', verwacht werd '" + expectedQualifiedName + "'. Controleer dit element handmatig.");
    }
}

function applyMigration(sourceProfile, targetProfile, instances) {
    var actionLog = [];
    var prefix = APPLY_CHANGES ? "[UITGEVOERD] " : "[DRY-RUN, niet uitgevoerd] ";

    logAction(actionLog, "=== Start migratie-acties (" + (APPLY_CHANGES ? "ECHT - tag-wijzigingen worden geschreven" : "DRY-RUN - er wordt niets geschreven") + ") ===");
    logAction(actionLog, "Dit script wijzigt GEEN stereotypes meer (zie scriptheader: elke geprobeerde methode bleek");
    logAction(actionLog, "onbetrouwbaar of risicovol). Alleen tagged values worden opgeschoond/hersteld. De");
    logAction(actionLog, "technology-koppeling van stereotypes wordt pas in de allerlaatste opschoonstap behandeld,");
    logAction(actionLog, "nadat VNGR_SIM_Grouping_NL nul resterende gebruikers heeft.");

    for (var i = 0; i < instances.length; i++) {
        var inst = instances[i];
        var loc = inst.path + " / " + inst.name + " (" + inst.kind + ", stereotype '" + inst.stereotype + "')";

        if (inst.stereotype.indexOf("::") !== -1) {
            logAction(actionLog, "GECORRUMPEERDE STEREOTYPE-NAAM (blijft liggen tot de eindopschoning): " + loc);
            continue;
        }

        var migStatus = stereotypeMigrationStatus(inst.stereotype, sourceProfile, targetProfile);

        var targetStereotypeName = null;
        if (migStatus === "no-equivalent") {
            var mappedName = STEREOTYPE_REMAP[inst.stereotype];
            if (!mappedName) {
                logAction(actionLog, "SKIP - handmatig vereist: " + loc + " heeft geen equivalent in " + TARGET_LABEL + " en er is geen STEREOTYPE_REMAP opgegeven.");
                continue;
            }
            if (!hasOwn(targetProfile, mappedName)) {
                logAction(actionLog, "FOUT: STEREOTYPE_REMAP wijst '" + inst.stereotype + "' naar '" + mappedName + "', maar dat stereotype bestaat niet in " + TARGET_LABEL + ". Overgeslagen: " + loc);
                continue;
            }
            targetStereotypeName = mappedName;
            logAction(actionLog, "Tags alvast opschonen voor " + loc + " (stereotype-hernoeming naar '" + mappedName + "' volgt bij de eindopschoning).");
        } else if (migStatus === "shared") {
            targetStereotypeName = inst.stereotype; // naam is al correct; alleen technology-koppeling blijft nog staan
        } else {
            continue; // target-only/unknown: niets te doen
        }

        var targetTags = targetProfile[targetStereotypeName].tags;
        var tagDiffRows = diffStereotypeTags(inst.stereotype, sourceProfile, targetProfile);
        var actions = buildInstanceActions(inst, tagDiffRows, targetTags);

        for (var a = 0; a < actions.length; a++) {
            var act = actions[a];

            if (act.status === "removed" || act.status === "unknown") {
                logAction(actionLog, prefix + "Tagged value '" + act.tagName + "' (waarde \"" + act.value + "\") verwijderen op " + loc + " - " + (act.status === "removed" ? "vervalt in " + TARGET_LABEL : "komt in geen van beide profielen voor") + ".");
                if (APPLY_CHANGES && REMOVE_OBSOLETE_TAGS) {
                    deleteTagFromCollection(inst.obj.TaggedValues, act.tagName);
                    inst.obj.Update();
                }
            } else if (act.status === "invalid-value") {
                var remapForStereo = VALUE_REMAP[inst.stereotype];
                var remapForTag = remapForStereo ? remapForStereo[act.tagName] : null;
                var newVal = remapForTag ? remapForTag[act.value] : null;

                if (newVal) {
                    logAction(actionLog, prefix + "Tagged value '" + act.tagName + "' op " + loc + " aanpassen: \"" + act.value + "\" -> \"" + newVal + "\".");
                    if (APPLY_CHANGES) {
                        setTagValueInCollection(inst.obj.TaggedValues, act.tagName, newVal);
                        inst.obj.Update();
                    }
                } else {
                    logAction(actionLog, "SKIP - handmatig vereist: " + loc + ", tag '" + act.tagName + "' heeft ongeldige waarde \"" + act.value + "\" en er is geen VALUE_REMAP opgegeven.");
                }
            } else if (act.status === "mandatory-missing") {
                logAction(actionLog, "WAARSCHUWING - verplicht veld leeg: " + loc + ", tag '" + act.tagName + "' is verplicht volgens " + TARGET_LABEL + " maar niet ingevuld.");
            } else if (act.status === "renamed" && act.remapTarget) {
                // Dit is de OUDE tag-kant van een geslaagde TAG_REMAP: waarde
                // overzetten naar de nieuwe tagnaam, dan de oude verwijderen.
                logAction(actionLog, prefix + "Tagged value '" + act.tagName + "' (waarde \"" + act.value + "\") hernoemen naar '" + act.remapTarget + "' op " + loc + ".");
                if (APPLY_CHANGES) {
                    var didSetRemap = false;
                    var addNewFailed = false;
                    try {
                        didSetRemap = setTagValueInCollection(inst.obj.TaggedValues, act.remapTarget, act.value);
                    } catch (eSetRemap) {
                        logAction(actionLog, "  FOUT bij setTagValueInCollection voor '" + act.remapTarget + "' op " + loc + ": " + eSetRemap.description);
                    }
                    if (!didSetRemap) {
                        try {
                            var newTvRemap = inst.obj.TaggedValues.AddNew(act.remapTarget, "");
                            newTvRemap.Value = act.value;
                            newTvRemap.Update();
                            inst.obj.TaggedValues.Refresh();
                        } catch (eAddRemap) {
                            logAction(actionLog, "  FOUT bij toevoegen van '" + act.remapTarget + "' op " + loc + ": " + eAddRemap.description);
                            addNewFailed = true;
                        }
                    }
                    if (!addNewFailed) {
                        var deleteOk = false;
                        try {
                            deleteOk = deleteTagFromCollection(inst.obj.TaggedValues, act.tagName);
                        } catch (eDelRemap) {
                            logAction(actionLog, "  FOUT bij verwijderen van '" + act.tagName + "' op " + loc + ": " + eDelRemap.description);
                        }
                        try {
                            inst.obj.Update();
                        } catch (eUpdRemap) {
                            logAction(actionLog, "  FOUT bij Update() op " + loc + ": " + eUpdRemap.description);
                        }

                        // VERIFICATIE: vers uitlezen wat er nu daadwerkelijk op
                        // het object staat, in plaats van te vertrouwen op de
                        // hierboven gelogde (optimistische) intentie.
                        try {
                            var freshTagsCheck = collectTags(inst.obj.TaggedValues);
                            var freshNewVal = freshTagsCheck[act.remapTarget];
                            var newValOk = (freshNewVal !== undefined && freshNewVal !== null && trimStr(String(freshNewVal)) === trimStr(String(act.value)));
                            var oldStillPresent = hasOwn(freshTagsCheck, act.tagName);
                            if (newValOk && !oldStillPresent) {
                                logAction(actionLog, "  Geverifieerd: '" + act.remapTarget + "' = \"" + freshNewVal + "\", oude tag '" + act.tagName + "' is weg. OK.");
                            } else {
                                logAction(actionLog, "  WAARSCHUWING - niet bevestigd na verificatie: '" + act.remapTarget + "' bevat nu \"" + freshNewVal + "\" (verwacht \"" + act.value + "\"), oude tag '" + act.tagName + "' " + (oldStillPresent ? "staat er nog" : "is weg") + ". Zoek dit element handmatig op ter controle: " + loc);
                            }
                        } catch (eVerifyRemap) {
                            logAction(actionLog, "  Kon niet verifiëren na hernoemen op " + loc + ": " + eVerifyRemap.description);
                        }
                    }
                }
            } else if (act.status === "renamed" && act.remapSource) {
                // Dit is de "ontvangende" kant - al afgehandeld bij de oude
                // tag hierboven, geen aparte actie nodig.
            } else if (act.status === "remap-conflict") {
                logAction(actionLog, "SKIP - handmatig vereist: " + loc + ", tag '" + act.tagName + "' kan niet automatisch hernoemd worden (doeltag heeft al een waarde).");
            } else if (act.status === "custom-action") {
                if (EXECUTE_CUSTOM_TAG_ACTIONS) {
                    logAction(actionLog, prefix + "Aparte actie uitvoeren voor tag '" + act.tagName + "' (waarde \"" + act.value + "\") op " + loc + ".");
                    if (APPLY_CHANGES) {
                        try {
                            act.customActionFn(act.value, inst.obj, actionLog, loc);
                            if (REMOVE_OBSOLETE_TAGS) {
                                deleteTagFromCollection(inst.obj.TaggedValues, act.tagName);
                            }
                            inst.obj.Update();
                        } catch (eCustom) {
                            logAction(actionLog, "FOUT bij uitvoeren van aparte actie voor '" + act.tagName + "' op " + loc + ": " + eCustom.description);
                        }
                    }
                } else {
                    logAction(actionLog, "MARKERING (niet uitgevoerd, EXECUTE_CUSTOM_TAG_ACTIONS=false): tag '" + act.tagName + "' (waarde \"" + act.value + "\") heeft een geconfigureerde aparte actie op " + loc + " - blijft ongewijzigd staan.");
                }
            } else if (act.status === "tag-added") {
                logAction(actionLog, prefix + "Toevoegen (leeg): '" + act.tagName + "' op " + loc + " (ontbrak, bestaat wel in " + TARGET_LABEL + ").");
                if (APPLY_CHANGES) {
                    try {
                        var newTvAdd = inst.obj.TaggedValues.AddNew(act.tagName, "");
                        newTvAdd.Value = "";
                        newTvAdd.Update();
                        inst.obj.TaggedValues.Refresh();
                    } catch (eAddTag) {
                        logAction(actionLog, "FOUT bij toevoegen van '" + act.tagName + "' op " + loc + ": " + eAddTag.description);
                    }
                }
            }
            // status "excluded": bewust geen actie - blijft ongewijzigd staan.
            // status "kept" en "changed" (alleen definitie-afwijking, waarde nog geldig): geen actie nodig.
        }

        // Voor STEREOTYPE_REMAP-gevallen: tags die niet bij het (toekomstige)
        // doelstereotype horen ook alvast signaleren/opruimen.
        if (targetStereotypeName !== inst.stereotype) {
            for (var tagName1 in inst.taggedValues) {
                if (!hasOwn(inst.taggedValues, tagName1)) { continue; }
                var val1 = inst.taggedValues[tagName1];
                if (val1 === undefined || val1 === null || trimStr(String(val1)) === "") { continue; }
                if (!hasOwn(targetTags, tagName1)) {
                    logAction(actionLog, prefix + "Tagged value '" + tagName1 + "' (waarde \"" + val1 + "\") vervalt bij toekomstige ommap naar '" + targetStereotypeName + "'.");
                    if (APPLY_CHANGES && REMOVE_OBSOLETE_TAGS) {
                        deleteTagFromCollection(inst.obj.TaggedValues, tagName1);
                        inst.obj.Update();
                    }
                }
            }
        }
    }

    logAction(actionLog, "=== Einde migratie-acties ===");
    return actionLog;
}


// =====================================================================
// Status-overzicht (alleen-lezen): hoeveel elementen zijn technology-
// gekoppeld aan VNGR_SIM_Grouping_NL versus VNGR_MIM_1.2_Grouping_NL. Puur
// informatief, wijzigt niets - nuttig om voortgang te volgen richting het
// moment waarop VNGR_SIM_Grouping_NL nul gebruikers meer heeft en de
// stereotype-koppeling in een keer definitief kan worden opgelost.
// =====================================================================
function reportTechnologyLinkStatus(targetProfile, actionLog) {
    logAction(actionLog, "=== Statusoverzicht technology-koppeling (alleen-lezen) ===");

    var freshInstances = [];
    if (ROOT_PACKAGE_GUID !== "") {
        var rootPkg = Repository.GetPackageByGuid(ROOT_PACKAGE_GUID);
        if (rootPkg) { walkPackage(rootPkg, safeName(rootPkg), freshInstances); }
    } else {
        var modelCount = Repository.Models.Count;
        for (var i = 0; i < modelCount; i++) {
            var rootModel = Repository.Models.GetAt(i);
            if (rootModel) { walkPackage(rootModel, safeName(rootModel), freshInstances); }
        }
    }

    var counts = { target: 0, source: 0, other: 0, unknown: 0 };
    for (var j = 0; j < freshInstances.length; j++) {
        var inst = freshInstances[j];
        if (!hasOwn(targetProfile, inst.stereotype)) { continue; }

        var xrefType = (inst.kind === "Element") ? "element property"
                     : (inst.kind === "Attribute") ? "attribute property"
                     : "connector property";
        var fqName = getStereotypeFQName(inst.guid, xrefType);
        var expectedTarget = TARGET_TECHNOLOGY_QUALIFIER_FOR_VERIFICATION + "::" + inst.stereotype;
        var expectedSource = SOURCE_TECHNOLOGY_QUALIFIER_NAME + "::" + inst.stereotype;

        if (fqName === null) { counts.unknown++; }
        else if (fqName === expectedTarget) { counts.target++; }
        else if (fqName === expectedSource) { counts.source++; }
        else { counts.other++; }
    }

    logAction(actionLog, "Van de elementen met een gedeeld stereotype: " + counts.target + " al gekoppeld aan " + TARGET_LABEL +
        ", " + counts.source + " nog aan " + SOURCE_LABEL + ", " + counts.other + " overig, " + counts.unknown + " niet te verifiëren.");
    logAction(actionLog, "Zodra 'nog aan " + SOURCE_LABEL + "' op 0 staat (en alle STEREOTYPE_REMAP-gevallen zijn afgehandeld), kan de eindopschoning van de technology-koppeling worden gepland.");
}
// =====================================================================
// Kleine hulpfuncties
// =====================================================================
// Geeft een korte, leesbare "vingerafdruk" van een tagnaam terug (lengte
// + tekencodes van eventuele niet-standaard tekens), om onzichtbare
// verschillen (spaties, non-breaking space, een ander streepje/leesteken)
// op te sporen wanneer een tagnaam onverwacht als "onbekend" verschijnt
// terwijl hij er in de profieldefinitie identiek uitziet.
function describeTagNameForDebug(name) {
    var s = String(name);
    var out = "lengte=" + s.length;
    var oddChars = [];
    var doubleSpacePositions = [];
    for (var i = 0; i < s.length; i++) {
        var code = s.charCodeAt(i);
        // Alles buiten de gebruikelijke ASCII-tekstrange (spatie t/m ~) apart benoemen
        if (code < 32 || code > 126) {
            oddChars.push("positie " + i + "='" + s.charAt(i) + "' (U+" + ("0000" + code.toString(16).toUpperCase()).slice(-4) + ")");
        }
        if (code === 32 && s.charCodeAt(i + 1) === 32) {
            doubleSpacePositions.push(i);
        }
    }
    if (s.charAt(0) === " " || s.charAt(s.length - 1) === " ") {
        out += ", let op: begint of eindigt met een spatie";
    }
    if (doubleSpacePositions.length > 0) {
        out += ", dubbele spatie op positie(s) " + doubleSpacePositions.join(", ");
    }
    if (oddChars.length > 0) {
        out += ", afwijkende tekens: " + oddChars.join("; ");
    }
    if (doubleSpacePositions.length === 0 && oddChars.length === 0) {
        out += ", geen afwijkende tekens/dubbele spaties gevonden (mogelijk hoofdlettergevoeligheid of een ander verschil)";
    }
    // Spaties zichtbaar maken door ze te vervangen door "·", zodat een
    // dubbele of onverwachte spatie ook met het blote oog te zien is.
    out += ", tekst met zichtbare spaties: [" + s.replace(/ /g, "\u00B7") + "]";
    return out;
}

// Spaties normaliseren: meerdere opeenvolgende witruimte-tekens worden 1
// spatie, en vooraan/achteraan wordt getrimd. Gebruikt om een tagnaam die
// alleen door een spatiefout afwijkt van de officiële profieldefinitie
// alsnog te herkennen (zie de "spatie-variant"-check hierboven).
function normalizeWhitespace(s) {
    return String(s).replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
}

function trimStr(s) {
    return String(s).replace(/^\s+|\s+$/g, "");
}

function hasOwn(obj, key) {
    return Object.prototype.hasOwnProperty.call(obj, key);
}

function unionSortedKeys(objA, objB) {
    var set = {};
    var k;
    for (k in objA) { if (hasOwn(objA, k)) { set[k] = true; } }
    for (k in objB) { if (hasOwn(objB, k)) { set[k] = true; } }
    var arr = [];
    for (k in set) { if (hasOwn(set, k)) { arr.push(k); } }
    arr.sort();
    return arr;
}

// Best-effort parser voor het 'values'-attribuut van een enumeratie-tag
// (komma-gescheiden lijst van toegestane keuzes). LET OP: minstens een
// enum in dit profiel bevat een optie met een komma erin (bv.
// "Ja, zie regels" bij "Indicatie materiele historie"), waardoor een
// simpele komma-split die ene optie verkeerd in tweeen knipt. Voor de
// meeste tags werkt dit prima; voor tags met zo'n ingebedde komma kan de
// validiteitscontrole hieronder onterecht een melding geven of missen -
// het rapport vermeldt dit voorbehoud daarom expliciet.
function parseEnumValues(str) {
    if (!str) { return []; }
    var parts = str.split(",");
    var out = [];
    for (var i = 0; i < parts.length; i++) {
        var v = trimStr(parts[i]);
        if (v !== "") { out.push(v); }
    }
    return out;
}

function arrayContains(arr, value) {
    for (var i = 0; i < arr.length; i++) {
        if (arr[i] === value) { return true; }
    }
    return false;
}

function escapeHtml(s) {
    if (s === undefined || s === null) { return ""; }
    s = String(s);
    s = s.replace(/&/g, "&amp;");
    s = s.replace(/</g, "&lt;");
    s = s.replace(/>/g, "&gt;");
    s = s.replace(/"/g, "&quot;");
    return s;
}

function writeTextFileUtf8(path, content) {
    // Zorg dat de doelmap bestaat
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var folder = fso.GetParentFolderName(path);
    if (folder !== "" && !fso.FolderExists(folder)) {
        fso.CreateFolder(folder);
    }

    // UTF-8 wegschrijven via ADODB.Stream (FileSystemObject.TextStream is niet Unicode-veilig)
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2; // tekst
    stream.Charset = "utf-8";
    stream.Open();
    stream.WriteText(content);

    // Bestaand bestand mag overschreven worden
    stream.SaveToFile(path, 2); // 2 = adSaveCreateOverWrite
    stream.Close();
}



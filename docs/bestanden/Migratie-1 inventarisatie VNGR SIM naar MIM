function buildReport(sourceProfile, targetProfile, instances, actionLog) {
    STATUS_LABEL["added"] = "Nieuw in " + TARGET_LABEL;
    STATUS_LABEL["invalid-value"] = "Waarde ongeldig in " + TARGET_LABEL;

    // Groepeer instances per stereotype-naam
    var instancesByStereotype = {};
    var i;
    for (i = 0; i < instances.length; i++) {
        var st = instances[i].stereotype;
        if (!instancesByStereotype[st]) { instancesByStereotype[st] = []; }
        instancesByStereotype[st].push(instances[i]);
    }

    // Index: ownerGuid -> attribuut-instances (voor snel opzoeken van children)
    var childrenByOwner = {};
    for (i = 0; i < instances.length; i++) {
        var inst = instances[i];
        if (inst.kind === "Attribute") {
            if (!childrenByOwner[inst.ownerGuid]) { childrenByOwner[inst.ownerGuid] = []; }
            childrenByOwner[inst.ownerGuid].push(inst);
        }
    }

    // Houd bij welke stereotype-namen door de 6 groepen zijn "geclaimd"
    var claimedNames = {};
    for (i = 0; i < GROUPS.length; i++) {
        claimedNames[GROUPS[i].parent] = true;
        for (var c = 0; c < GROUPS[i].children.length; c++) { claimedNames[GROUPS[i].children[c]] = true; }
    }

    // Totalen voor het overzicht bovenaan
    var totals = { kept: 0, changed: 0, removed: 0, unknown: 0 };
    var elementTotals = { total: 0, withActions: 0 };

    var sectionsHtml = [];

    // ---- de zes hoofdgroepen ----
    for (i = 0; i < GROUPS.length; i++) {
        var group = GROUPS[i];
        var parentInstances = instancesByStereotype[group.parent] || [];
        var groupBlocks = [];

        // Profielniveau tag-diff (1x, ter referentie) voor parent en children
        var parentTagDiff = diffStereotypeTags(group.parent, sourceProfile, targetProfile);
        var parentMigStatus = stereotypeMigrationStatus(group.parent, sourceProfile, targetProfile);

        groupBlocks.push(renderProfileDiffCard(group.parent, parentMigStatus, parentTagDiff));

        for (var c2 = 0; c2 < group.children.length; c2++) {
            var childName = group.children[c2];
            var childTagDiff = diffStereotypeTags(childName, sourceProfile, targetProfile);
            var childMigStatus = stereotypeMigrationStatus(childName, sourceProfile, targetProfile);
            groupBlocks.push(renderProfileDiffCard(childName, childMigStatus, childTagDiff));
        }

        // Instanties uit het model
        if (parentInstances.length === 0) {
            groupBlocks.push('<p class="muted">Geen elementen met stereotype "' + escapeHtml(group.parent) + '" gevonden in het doorzochte deel van het model.</p>');
        } else {
            for (var p = 0; p < parentInstances.length; p++) {
                var parentInst = parentInstances[p];
                var parentActions = buildInstanceActions(parentInst, parentTagDiff, targetProfile[group.parent].tags);
                elementTotals.total++;
                if (parentActions.length > 0) { elementTotals.withActions++; }
                for (var pa = 0; pa < parentActions.length; pa++) { totals[parentActions[pa].status] = (totals[parentActions[pa].status] || 0) + 1; }

                var childInstBlocks = [];
                var relatedChildren = childrenByOwner[parentInst.guid] || [];
                for (var rc = 0; rc < relatedChildren.length; rc++) {
                    var childInst = relatedChildren[rc];
                    var isRequestedChild = false;
                    for (var cc = 0; cc < group.children.length; cc++) {
                        if (group.children[cc] === childInst.stereotype) { isRequestedChild = true; break; }
                    }
                    if (!isRequestedChild) { continue; }

                    var childTagDiffForInst = diffStereotypeTags(childInst.stereotype, sourceProfile, targetProfile);
                    var childActions = buildInstanceActions(childInst, childTagDiffForInst, targetProfile[childInst.stereotype].tags);
                    elementTotals.total++;
                    if (childActions.length > 0) { elementTotals.withActions++; }
                    for (var ca = 0; ca < childActions.length; ca++) { totals[childActions[ca].status] = (totals[childActions[ca].status] || 0) + 1; }

                    childInstBlocks.push(renderInstanceCard(childInst, childActions, 5));
                }

                groupBlocks.push(renderInstanceCard(parentInst, parentActions, 4, childInstBlocks));
            }
        }

        var anchor = anchorId(group.parent);
        sectionsHtml.push(
            '<section class="group" id="grp-' + anchor + '">' +
            '<h2 class="group-heading">' + escapeHtml(group.parent) + ' <span class="muted small">met ' + escapeHtml(group.children.join(" / ")) + '</span></h2>' +
            groupBlocks.join("") +
            "</section>"
        );
    }

    // ---- overige stereotypes: zonder equivalent (kritiek) en gedeeld ----
    var noEquivBlocks = [];
    var sharedBlocks = [];
    var handledNoEquiv = {};
    var handledShared = {};

    for (var stName in instancesByStereotype) {
        if (!hasOwn(instancesByStereotype, stName)) { continue; }
        if (claimedNames[stName]) { continue; } // al behandeld in een van de 6 groepen

        var migStatus = stereotypeMigrationStatus(stName, sourceProfile, targetProfile);
        var stInstances = instancesByStereotype[stName];

        if (migStatus === "no-equivalent" && !handledNoEquiv[stName]) {
            handledNoEquiv[stName] = true;
            var neInstanceActionPairs = [];
            for (var n1 = 0; n1 < stInstances.length; n1++) {
                var neInst = stInstances[n1];
                var neActions = buildAllRemovedActions(neInst);
                elementTotals.total++;
                if (neActions.length > 0) { elementTotals.withActions++; }
                totals["removed"] = (totals["removed"] || 0) + neActions.length;
                neInstanceActionPairs.push({ instance: neInst, actions: neActions });
            }
            noEquivBlocks.push(renderNoEquivalentCard(stName, neInstanceActionPairs));
        } else if (migStatus === "shared" && !handledShared[stName]) {
            handledShared[stName] = true;
            var shTagDiff = diffStereotypeTags(stName, sourceProfile, targetProfile);
            var shBlocks = [renderProfileDiffCard(stName, migStatus, shTagDiff)];
            for (var n2 = 0; n2 < stInstances.length; n2++) {
                var shInst = stInstances[n2];
                var shActions = buildInstanceActions(shInst, shTagDiff, targetProfile[stName].tags);
                elementTotals.total++;
                if (shActions.length > 0) { elementTotals.withActions++; }
                for (var sa = 0; sa < shActions.length; sa++) { totals[shActions[sa].status] = (totals[shActions[sa].status] || 0) + 1; }
                shBlocks.push(renderInstanceCard(shInst, shActions, 4));
            }
            sharedBlocks.push(
                '<div class="stereotype-block s-unchanged" id="' + anchorId(stName) + '">' +
                '<h3 class="stereotype-heading">' + escapeHtml(stName) + ' <span class="badge s-unchanged">Gedeeld</span></h3>' +
                shBlocks.join("") +
                "</div>"
            );
        }
    }

    if (noEquivBlocks.length > 0) {
        sectionsHtml.push(
            '<section class="group critical" id="grp-no-equivalent">' +
            '<h2 class="group-heading">&#9888; Stereotypes zonder equivalent in ' + escapeHtml(TARGET_LABEL) + '</h2>' +
            '<p class="muted">Deze stereotypes komen voor in het model (op basis van ' + escapeHtml(SOURCE_LABEL) + '), maar bestaan niet in ' + escapeHtml(TARGET_LABEL) + '. Elementen met deze stereotypes moeten handmatig worden omgezet naar een ander (wel bestaand) stereotype, of uit het gemigreerde model worden verwijderd.</p>' +
            noEquivBlocks.join("") +
            "</section>"
        );
    }

    if (sharedBlocks.length > 0) {
        sectionsHtml.push(
            '<section class="group" id="grp-overige-gedeeld">' +
            '<h2 class="group-heading">Overige gedeelde stereotypes</h2>' +
            '<p class="muted">Stereotypes die in beide profielen bestaan, maar niet tot een van de zes hoofdgroepen behoren.</p>' +
            sharedBlocks.join("") +
            "</section>"
        );
    }

    return renderHtmlDocument(sectionsHtml, totals, elementTotals, instances.length, actionLog);
}

function anchorId(name) {
    return "st-" + String(name).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}

function renderProfileDiffCard(stereoName, migStatus, tagDiffRows) {
    if (migStatus === "no-equivalent") {
        return (
            '<div class="stereotype-block s-removed">' +
            '<h4 class="stereotype-heading">' + escapeHtml(stereoName) + ' <span class="badge s-removed">Geen equivalent in ' + escapeHtml(TARGET_LABEL) + '</span></h4>' +
            "</div>"
        );
    }
    if (migStatus === "target-only") {
        return (
            '<div class="stereotype-block s-added">' +
            '<h4 class="stereotype-heading">' + escapeHtml(stereoName) + ' <span class="badge s-added">Alleen in ' + escapeHtml(TARGET_LABEL) + ', niet in model</span></h4>' +
            "</div>"
        );
    }

    var counts = { added: 0, removed: 0, changed: 0, unchanged: 0 };
    var i;
    for (i = 0; i < tagDiffRows.length; i++) { counts[tagDiffRows[i].status]++; }
    var countStr = [];
    if (counts.removed) { countStr.push(counts.removed + " vervalt"); }
    if (counts.changed) { countStr.push(counts.changed + " gewijzigd"); }
    if (counts.added) { countStr.push(counts.added + " nieuw in " + TARGET_LABEL); }
    if (counts.unchanged) { countStr.push(counts.unchanged + " ongewijzigd"); }

    var rowsHtml = [];
    for (i = 0; i < tagDiffRows.length; i++) {
        var r = tagDiffRows[i];
        var cls = STATUS_CLASS[r.status];
        var isMandatory = r.tgt && r.tgt.mandatory;
        rowsHtml.push(
            '<tr class="' + cls + '">' +
            '<td class="tagname">' + escapeHtml(r.name) + (isMandatory ? ' <span class="badge s-mandatory">Verplicht</span>' : "") + "</td>" +
            '<td><span class="badge ' + cls + '">' + STATUS_LABEL[r.status] + "</span></td>" +
            '<td class="muted">' + escapeHtml(r.changedFields.join(", ")) + "</td>" +
            "</tr>"
        );
    }

    return (
        '<div class="stereotype-block s-refcard">' +
        '<h4 class="stereotype-heading">' + escapeHtml(stereoName) +
        ' <span class="muted small">(profieldefinitie: ' + escapeHtml(countStr.join(" &middot; ")) + ')</span></h4>' +
        '<details><summary class="muted small">Toon volledige tagged-value-definitievergelijking</summary>' +
        '<table class="tagtable"><thead><tr><th>Tagged value</th><th>Status</th><th>Afwijkende velden</th></tr></thead>' +
        "<tbody>" + rowsHtml.join("") + "</tbody></table>" +
        "</details>" +
        "</div>"
    );
}

function renderInstanceCard(instance, actions, headingLevel, childBlocksHtmlArray) {
    var h = "h" + headingLevel;

    // De kaart zelf krijgt GEEN kleur op basis van de ergst voorkomende status
    // van zijn tagged values - dat zou ten onrechte de indruk wekken dat het
    // hele element/attribuut ongeldig is, terwijl het vaak maar om 1 tag gaat.
    // Kleur wordt uitsluitend per tabelrij (per tag) toegepast, hieronder.
    var attentionCount = 0;
    for (var i = 0; i < actions.length; i++) {
        var s = actions[i].status;
        if (s !== "kept" && s !== "unchanged") { attentionCount++; }
    }
    var cls = "s-unchanged"; // neutraal, altijd
    var badgeText;
    if (actions.length === 0) {
        badgeText = "Geen ingevulde tagged values";
    } else if (attentionCount === 0) {
        badgeText = "Alles in orde (" + actions.length + ")";
    } else {
        badgeText = attentionCount + " van " + actions.length + " tagged value(s) heeft aandacht nodig";
    }

    var actionsHtml;
    if (actions.length === 0) {
        actionsHtml = '<p class="muted small">Geen ingevulde tagged values op dit element.</p>';
    } else {
        var rows = [];
        for (var j = 0; j < actions.length; j++) {
            var a = actions[j];
            var aCls = STATUS_CLASS[a.status];
            rows.push(
                '<tr class="' + aCls + '">' +
                '<td class="tagname">' + escapeHtml(a.tagName) + "</td>" +
                '<td><span class="badge ' + aCls + '">' + STATUS_LABEL[a.status] + "</span></td>" +
                "<td>" + escapeHtml(a.value) + "</td>" +
                '<td class="muted small">' + escapeHtml(a.note) + "</td>" +
                "</tr>"
            );
        }
        actionsHtml =
            '<table class="tagtable"><thead><tr><th>Tagged value</th><th>Actie</th><th>Huidige waarde</th><th>Toelichting</th></tr></thead>' +
            "<tbody>" + rows.join("") + "</tbody></table>";
    }

    var childHtml = (childBlocksHtmlArray && childBlocksHtmlArray.length > 0) ? childBlocksHtmlArray.join("") : "";

    return (
        '<div class="instance-block ' + cls + '">' +
        "<" + h + ' class="instance-heading">' + escapeHtml(instance.name) +
        ' <span class="badge ' + cls + '">' + badgeText + "</span>" +
        "</" + h + ">" +
        '<p class="muted small">' + escapeHtml(instance.stereotype) + " &middot; " + escapeHtml(instance.kind) +
        " &middot; " + escapeHtml(instance.path) + " &middot; GUID " + escapeHtml(instance.guid) + "</p>" +
        actionsHtml +
        childHtml +
        "</div>"
    );
}

function renderNoEquivalentCard(stereoName, instanceActionPairs) {
    var blocks = [];
    for (var i = 0; i < instanceActionPairs.length; i++) {
        blocks.push(renderInstanceCard(instanceActionPairs[i].instance, instanceActionPairs[i].actions, 4));
    }
    return (
        '<div class="stereotype-block s-removed" id="' + anchorId(stereoName) + '">' +
        '<h3 class="stereotype-heading">' + escapeHtml(stereoName) +
        ' <span class="badge s-removed">Geen equivalent</span> ' +
        '<span class="muted small">(' + instanceActionPairs.length + " voorkomen(s) in het model)</span></h3>" +
        '<p class="muted small">Dit stereotype bestaat niet in ' + escapeHtml(TARGET_LABEL) + '. Het element/attribuut zelf moet worden omgezet naar een ander (wel bestaand) stereotype; alle onderstaande tagged values vervallen daarmee automatisch mee.</p>' +
        blocks.join("") +
        "</div>"
    );
}

